# TEMPLATE, not installed. wintop (WSL) replica: the same lane-store binary, receiving journal-ordered pushes
# from pitelite. Replace @TAILNET_IP@ with the replica's tailnet address. /etc/lane-store/env holds
# LANE_STORE_SECRET (the replica verifies the `replica` role token the primary's replicator presents).
[Unit]
Description=lane-store: content-addressed snapshot store (replica)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=lane-store
Group=lane-store
EnvironmentFile=/etc/lane-store/env
ExecStart=/usr/bin/node /opt/lane-broker/bin/lane-store.js serve --root /data/lane-store --listen @TAILNET_IP@:7480 --max-blob-bytes 512MiB --cap-bytes 100GB
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=100%
IOWeight=10
MemoryHigh=512M
ProtectSystem=strict
ReadWritePaths=/data/lane-store
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
