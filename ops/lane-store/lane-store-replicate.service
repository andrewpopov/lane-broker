# TEMPLATE, not installed. pitelite: one journal-ordered replication round, run by lane-store-replicate.timer.
# /etc/lane-store/replicate.env (0600, root): LANE_STORE_REPLICA_TOKEN=<role=replica token>
[Unit]
Description=lane-store: replicate the journal to the wintop replica (one round)

[Service]
Type=oneshot
User=lane-store
Group=lane-store
EnvironmentFile=/etc/lane-store/replicate.env
ExecStart=/usr/bin/node /opt/lane-broker/bin/lane-store.js replicate --root /data/lane-store --replica-url http://@REPLICA_TAILNET_IP@:7480
Nice=10
CPUQuota=100%
IOWeight=10
ProtectSystem=strict
ReadWritePaths=/data/lane-store
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
