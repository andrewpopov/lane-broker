# TEMPLATE, not installed. pitelite: weekly full compare of the store against the replica (exit 2 = divergence).
# /etc/lane-store/replicate.env as for the replicate unit; add LANE_STORE_ADMIN_TOKEN only if --repair is wanted.
[Unit]
Description=lane-store: weekly full compare against the replica

[Service]
Type=oneshot
User=lane-store
Group=lane-store
EnvironmentFile=/etc/lane-store/replicate.env
ExecStart=/usr/bin/node /opt/lane-broker/bin/lane-store.js compare --root /data/lane-store --replica-url http://@REPLICA_TAILNET_IP@:7480 --deep
Nice=10
CPUQuota=100%
IOWeight=10
ProtectSystem=strict
ReadWritePaths=/data/lane-store
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
