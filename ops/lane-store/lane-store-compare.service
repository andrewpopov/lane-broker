# TEMPLATE, not installed. pitelite: weekly full compare of the store against the replica (exit 2 = divergence).
# Asks the RUNNING primary (which holds the store lock and is the only reader of the journal) to compare itself with the
# replica. /etc/lane-store/compare.env (0600, root): LANE_STORE_ADMIN_TOKEN=<role=admin token>.
[Unit]
Description=lane-store: weekly full compare against the replica

[Service]
Type=oneshot
User=lane-store
Group=lane-store
EnvironmentFile=/etc/lane-store/compare.env
ExecStart=/usr/bin/node /opt/lane-broker/bin/lane-store.js compare --url http://@TAILNET_IP@:7480 --deep
Nice=10
CPUQuota=100%
IOWeight=10
ProtectSystem=strict
ReadWritePaths=/data/lane-store
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
