# TEMPLATE, not installed. pitelite: the pull tender, one persistent process on the SUBMITTER login (lane_submit_train).
# Same user and LANE_BROKER_HOME/LANE_BROKER_STATE as the supervisors it recovers; the broker config carries laneQueueUrl and lanePull (password, CA, RustFS keys).
# Credentials: lanePull.passwordFile is /etc/lane-pull/submit.pass (train, 0600). The admin password /etc/lane-pull/gc-admin.pass is root-only and hidden from this unit.
[Unit]
Description=lane pull tend: steps pull tickets whose supervisor is dead
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=train
Environment=LANE_BROKER_HOME=/data/train/config
Environment=LANE_BROKER_STATE=/data/train/state
ExecStart=/usr/bin/node /opt/lane-broker/bin/lane.js pull tend --serve
Restart=always
RestartSec=5
Nice=10
InaccessiblePaths=-/etc/lane-pull/gc-admin.pass
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
