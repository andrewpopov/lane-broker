{
  "version": 1,
  "lane": "train",
  "command": [
    "sh",
    "scripts/train-gate.sh",
    "all"
  ],
  "fastTier": "verify:fast",
  "batchSize": 4,
  "maxExtraRunsPerBatch": 2,
  "maxRebuilds": 2,
  "soloPaths": [
    ".githooks/**",
    ".train.json",
    "package-lock.json"
  ],
  "verifyMaster": true,
  "prCi": {
    "lane": "pr",
    "command": [
      "sh",
      "scripts/train-gate.sh",
      "pr"
    ],
    "fallbackCommand": [
      "sh",
      "scripts/train-gate.sh",
      "pr"
    ],
    "maxConcurrent": 2
  }
}
